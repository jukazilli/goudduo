{
  "name": "goudduo-approved-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.22.x",
    "pnpm": "11.25.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm typecheck && vite build --mode app && node scripts/finalize-build.mjs app && node scripts/check-bundle.mjs app",
    "build:lab": "pnpm typecheck && vite build --mode lab && node scripts/finalize-build.mjs lab && node scripts/check-bundle.mjs lab",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs app",
    "cloudflare:prepare": "pnpm check:bundle && cf deploy dist/app --dry-run --mode production --provision=false",
    "cloudflare:validate": "cf deploy --prebuilt --dry-run --mode production"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "cf": "1.0.0-beta.30",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
