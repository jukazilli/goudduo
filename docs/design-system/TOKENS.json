    "source": "proposed_except_bento_card_reference_from_V51_and_pulse_from_V53"
  },
  "controls": {
    "tap_target": {
      "minimum_css_px": 48,
      "status": "proposed_platform_target",
      "notes": "Recomendação de conforto cross-platform; iOS 44pt, Android 48dp e WCAG 2.2 AA 24px mínimo com exceções. Não confundir com tamanho do desenho visível."
    },
    "primaryButton": {
      "height_css_px": 56,
      "minimum_height_css_px": 48,
      "width": "full_when_primary_in_forms",
      "horizontal_padding_px": 20,
      "text_only": true,
      "status": "proposed"
    },
    "secondaryButton": {
      "height_css_px": 48,
      "horizontal_padding_px": 16,
      "text_only": true,
      "status": "proposed"
    },
    "compactButton": {
      "height_css_px": 44,
      "hitbox_min_css_px": 48,
      "text_only": true,
      "status": "proposed"
    },
    "iconButton": {
      "hitbox_min_css_px": 48,
      "icon_size_px": 22,
      "icon_only": true,
      "aria_label_required": true,
      "background": "transparent_by_default",
      "status": "proposed"
    },
    "textField": {
      "height_css_px": 56,
      "font_size_css_px": 16,
      "radius_px": 16,
      "label_location": "outside_or_above",
      "status": "proposed"
    },
    "checkbox": {
      "hitbox_min_css_px": 48,
      "status": "proposed"
    },
    "authProvider": {
      "hitbox_min_css_px": 48,
      "content": "brand_icon_only_with_accessible_name",
      "background": "neutral_by_semantic_auth_choice",
      "status": "proposed"
    },
    "cta_policy": "Uma ação contém apenas texto OU apenas ícone. Não misturar ícone+texto; exceção depende de autorização explícita documentada."
  },
  "motion": {
    "feedback_ms": {
      "value": 160,
      "status": "proposed"
    },
    "screenTransition_ms": {
      "value": 260,
      "status": "proposed"
    },
    "bottomSheet_ms": {
      "value": 300,
      "status": "proposed"
    },
    "easing": "cubic-bezier(.22,1,.36,1)",
    "reduced_motion": "Respeitar prefers-reduced-motion: reduce, evitar deslocamento decorativo e minimizar duração.",
    "avoid": [
      "transição seca sem feedback",
      "animação excessiva",
      "delay de navegação inventado para impressionar"
    ]
  },
  "surface_policy": {
    "splash": {
      "background": "#FFFFFF",
      "exception": "somente a composição aprovada; copy vigente será reavaliada por tela"
    },
    "login": {
      "visual_mode": "energetic",
      "gradients": "allowed_only_here_as_fullscreen_hero",
      "image": "duas pessoas treinando/atividade autenticamente fotografadas"
    },
    "sign_up": {
      "visual_mode": "calm",
      "background": [
        "#FFFFFF",
        "#F1F8FB"
      ],
      "gradient": "none"
    },
    "oauth_completion": {
      "visual_mode": "calm",
      "gradient": "none"
    },
    "otp_register": {
      "visual_mode": "calm",
      "gradient": "none"
    },
    "password_recovery": {
      "visual_mode": "calm",
      "gradient": "none"
    },
    "otp_recovery": {
      "visual_mode": "calm",
      "gradient": "none"
    },
    "password_reset": {
      "visual_mode": "calm",
      "gradient": "none"
    },
    "success": {
      "visual_mode": "calm",
      "gradient": "none"
    },
    "home_treinos": {
      "visual_mode": "approved_bento_v53",
      "exceptions": [
        "pastel_bento_cards",
        "charcoal_workout_card_gradient",
        "contextual_Pulse_ring_gradients"
      ],
      "note": "Não propagar gradientes para outras telas a partir desta exceção"
    },
    "other_internal": {
      "visual_mode": "calm",
      "gradient": "none_unless_specifically_approved_per_screen"
    }
  },
  "iconography": {
    "library": "Lucide consistente para ícones de UI; logos de provedores apenas assets oficiais próprios",
    "no_auto_circle_background": true,
    "no_auto_badge_background": true,
    "no_icon_plus_label_buttons": true,
    "icon_only_requires_accessible_name": true,
    "exceptions_need_specific_approved_reason": true
  },
  "validation": {
    "contrast": {
      "body_text_ratio_min": 4.5,
      "large_text_ratio_min": 3,
      "non_text_ratio_min": 3,
      "source": "WCAG 2.2 guidance"
    },
    "audited_pairs": [
      {
        "foreground": "#10202B",
        "background": "#00A8E8",
        "contrast_ratio": 6.15,
        "result": "AA_BODY_PASS"
      },
      {
        "foreground": "#FFFFFF",
        "background": "#00A8E8",
        "contrast_ratio": 2.7,
        "result": "AA_BODY_FAIL"
      },
      {
        "foreground": "#FFFFFF",
        "background": "#006DA9",
        "contrast_ratio": 5.58,
        "result": "AA_BODY_PASS"
      },
      {
        "foreground": "#10202B",
        "background": "#C7F238",
        "contrast_ratio": 12.81,
        "result": "AA_BODY_PASS"
      },
      {
        "foreground": "#FFFFFF",
        "background": "#10202B",
        "contrast_ratio": 16.62,
        "result": "AA_BODY_PASS"
      }
    ],
    "mandatory_QA": [
      "320/390/430 mobile CSS viewport",
      "keyboard and iOS focus/zoom",
      "safe areas and bottom navigation",
      "long translations and 200% text zoom",
      "reduced motion",
      "RTL if supported later",
      "empty/error/loading/retry/no network",
      "existing approved components without regression"
    ]
  }
}
